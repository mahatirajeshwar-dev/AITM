run = "PORT=5000 npm run start"
entrypoint = "server/index.js"
modules = ["nodejs-22"]

[deployment]
build = ["sh", "-c", "npm install && npm run build && npx prisma db push && node prisma/seed.js"]
run = ["sh", "-c", "PORT=5000 npm run start"]

[[ports]]
localPort = 5000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 npm run start"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
