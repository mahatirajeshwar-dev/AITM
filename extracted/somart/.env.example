# Database — SQLite for dev; for production Postgres set e.g.
# DATABASE_URL="postgresql://user:pass@host:5432/somart"
# (also change provider in prisma/schema.prisma to "postgresql")
DATABASE_URL="file:./dev.db"

# Secret used to sign auth tokens/sessions — use a long random string
SESSION_SECRET=

# Only emails on this domain can register
ALLOWED_EMAIL_DOMAIN=bitsom.edu.in

# Default admin account (created/updated on seed)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional email provider key. If empty, verification/reset codes are
# logged to the server console and (in dev only) returned in API responses.
EMAIL_SERVICE_API_KEY=

# OTP settings
OTP_EXPIRY_MINUTES=30
OTP_MAX_ATTEMPTS=5

PORT=3000
